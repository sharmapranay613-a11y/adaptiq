{"ts":"2026-08-06T10:45:34.507908","pid":28176,"tid":"2f80|mux t4","sev":"info","req":"6","sess":"HYw1P3p-Rc6VkHj6EydsVw","ctx":{"workload":{"name":"tableau-interactive"},"tenant-id":"-","user-agent":"{\"app\": \"Tableau Public\", \"edition\": \"public\", \"version\": \"20262.26.0708.1337\"}","client":{"req":"RR-1x52hq61wgdku612fkb5z1aut09i","sess":"RS-16002sw061rut919bk7qx07b368c","site":"-","user":"-","host":"Pranay26"}},"k":"query-begin","v":{"spooling":false,"query-settings-active":false,"query-hash":"d7a2.459d0bfad00c.b7b752","query":"SELECT a.attname, a.atttypid, a.attnotnull, a.attnum, a.atttypmod, s.n_distinct,\n       CASE WHEN a.attcollation <> t.typcollation THEN c.collname ELSE NULL END AS attcollation,\n       d.description\n  FROM pg_catalog.pg_attribute a\n  JOIN pg_catalog.pg_class cl\n    ON a.attrelid = cl.oid\n  LEFT JOIN pg_catalog.pg_description d\n    ON cl.oid = d.objoid AND a.attnum = d.objsubid\n  LEFT JOIN pg_catalog.pg_collation c\n    ON c.oid = a.attcollation\n  LEFT JOIN pg_catalog.pg_type t\n    ON t.oid = a.atttypid\n  LEFT JOIN pg_catalog.pg_stats s\n    ON s.attname = a.attname AND s.tablename = 'Extract' AND s.schemaname = 'Extract'\n  WHERE a.attnum > 0\n   AND NOT a.attisdropped\n   AND cl.relname = 'Extract'\n   AND cl.relnamespace = 10004"}}
